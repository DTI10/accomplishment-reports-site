---
import { getCollection } from "astro:content"
import PostList from "../../components/PostList.astro"
import BaseLayout from "../../layouts/BaseLayout.astro"
import { getProvinces, getPublishedPosts } from "../../lib/content"
import { OFFICES, officeHref } from "../../lib/offices"

export function getStaticPaths() {
  return OFFICES.map((office) => ({
    params: { office: office.slug },
    props: { office }
  }))
}

const { office } = Astro.props

// Banner title: content/offices/<slug>.md (name, optional)
const entry = (await getCollection("offices")).find((e) => e.id === office.slug)
const name = entry?.data.name ?? office.province

const allPosts = await getPublishedPosts("articles")

// Every post whose Province / Office matches this page, newest first
const posts = allPosts.filter(
  (post) => getProvinces(post.data)[0] === office.province
)

// The "Browse by office" band: every office with how many accomplishments it has
const counts = new Map<string, number>()
for (const post of allPosts) {
  const province = getProvinces(post.data)[0]
  if (province) counts.set(province, (counts.get(province) ?? 0) + 1)
}
const countLabel = (province: string) => {
  const n = counts.get(province) ?? 0
  return n === 0 ? "No posts yet" : `${n} ${n === 1 ? "accomplishment" : "accomplishments"}`
}
---

<BaseLayout
  hero
  title={name}
  description={`Accomplishments from ${name}, DTI Region 10.`}
>
  <header class="post-head text-mist">
    <div class="shell pt-32 pb-12 sm:pt-36 sm:pb-14">
      <nav aria-label="Breadcrumb" class="text-sm text-dti-gold">
        <a href="/accomplishments/" class="underline-offset-4 hover:underline">Accomplishments</a>
        <span aria-hidden="true" class="mx-2 text-dti-gold/60">/</span>
        <span aria-current="page">{office.province}</span>
      </nav>
      <h1 class="display mt-6 max-w-4xl text-[clamp(2rem,4.5vw,3.25rem)] text-white">
        {name}
      </h1>
    </div>
  </header>

  <section class="bg-mist" aria-label={`${office.province} accomplishments`}>
    <div class="shell py-14 sm:py-16">
      {posts.length > 0 ? (
        <PostList
          posts={posts}
          pageSize={9}
          hideProvince
          morph
          showFilters={posts.length > 9}
        />
      ) : (
        <p class="rounded-md border border-dashed border-navy/25 bg-white p-12 text-center text-ink/65">
          No accomplishments from this office have been published yet.
        </p>
      )}
    </div>
  </section>

  <nav class="bg-mist-deep/60" aria-label="Offices">
    <div class="shell py-14 sm:py-16">
      <p class="text-[0.7rem] font-semibold tracking-[0.18em] text-ink/55 uppercase">
        Browse by province
      </p>
      <h2 class="display mt-2 text-[clamp(1.5rem,2.6vw,2rem)] text-navy">Offices of Region 10</h2>
      <ul class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3">
        {OFFICES.map((o) => {
          const current = o.slug === office.slug
          const tile =
            "flex h-full min-h-[4.5rem] flex-col justify-center rounded-md px-4 py-3 sm:px-5 sm:py-4"
          return (
            <li>
              {current ? (
                <span aria-current="page" class:list={[tile, "bg-navy text-white"]}>
                  <span class="font-semibold">{o.province}</span>
                  <span class="mt-0.5 text-sm text-mist/70">You are here</span>
                </span>
              ) : (
                <a
                  href={officeHref(o.slug)}
                  class:list={[
                    tile,
                    "group border border-navy/12 bg-white transition-[border-color,box-shadow] duration-200 hover:border-navy/30 hover:shadow-[inset_0_2px_0_var(--color-dti-gold)] focus-visible:shadow-[inset_0_2px_0_var(--color-dti-gold)]"
                  ]}
                >
                  <span class="flex items-center gap-2 font-semibold text-navy">
                    {o.province}
                    <svg
                      viewBox="0 0 16 16"
                      width="14"
                      height="14"
                      aria-hidden="true"
                      class="shrink-0 transition-transform duration-200 group-hover:translate-x-1"
                    >
                      <path
                        d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                  <span class="mt-0.5 text-sm text-ink/60">{countLabel(o.province)}</span>
                </a>
              )}
            </li>
          )
        })}
      </ul>
    </div>
  </nav>
</BaseLayout>
