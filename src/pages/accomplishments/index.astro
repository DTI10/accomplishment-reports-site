---
import PostArchive from '../../components/PostArchive.astro';
import { getPublishedPosts } from '../../lib/content';

const posts = await getPublishedPosts('articles');
---

<PostArchive
	posts={posts}
	eyebrow="Accomplishments"
	title="Accomplishments"
	description="Accomplishments and results from the Department of Trade and Industry, Region 10."
	emptyMessage="No accomplishments have been published yet."
/>
