---
import FeaturedHero, { type HeroItem } from "../components/gallery/FeaturedHero"
import RecentAccomplishments from "../components/RecentAccomplishments.astro"
import BaseLayout from "../layouts/BaseLayout.astro"
import {
  altFromFilename,
  formatPostDate,
  getPostHref,
  getProvinces,
  getPublishedPosts,
  getSummary
} from "../lib/content"

const articles = await getPublishedPosts("articles")
const allPosts = [...articles].sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
)

// The hero shows the five latest posts, newest first.
const heroPosts = allPosts.slice(0, 5)

const featured: HeroItem[] = heroPosts.map((post) => ({
  id: `${post.collection}-${post.id}`,
  tag: "Accomplishment",
  provinces: getProvinces(post.data),
  date: formatPostDate(post.data.date, "long"),
  title: post.data.title,
  summary: getSummary(post),
  href: getPostHref(post),
  alt: altFromFilename(post.data.image, post.data.title),
  src: post.data.image || undefined
}))
---

<BaseLayout
  hero
  title="DTI Region 10 Accomplishment Report"
  description="Official accomplishment report of the Department of Trade and Industry, Region 10 (Northern Mindanao): accomplishments and results."
>
  {featured[0]?.src && (
    <link slot="head" rel="preload" as="image" href={featured[0].src} fetchpriority="high" />
  )}
  {featured.length > 0 ? (
    <section id="top" class="featured-hero relative bg-navy-deep text-mist">
      <h1 class="sr-only">DTI Region 10 Accomplishment Report</h1>
      <FeaturedHero client:load items={featured} />
      <script is:inline>
        // Reveal each hero photo with a fade once it has loaded (instead of popping in).
        document.querySelectorAll("img.fh-photo").forEach(function (el) {
          var done = function () { el.setAttribute("data-loaded", "") }
          if (el.complete && el.naturalWidth > 0) {
            // already loaded (cached): show it at once, no fade
            el.style.transition = "none"
            done()
          } else {
            el.addEventListener("load", done)
            el.addEventListener("error", done)
          }
        })
      </script>
    </section>
  ) : (
    <section
      id="top"
      class="relative isolate flex min-h-[80svh] items-end bg-navy text-mist"
    >
      <div class="shell pb-20 pt-40">
        <h1 class="display text-[clamp(2.6rem,8vw,6rem)]">
          DTI Region 10
          <span
            class="block text-[0.5em] font-semibold text-mist/85 font-stretch-[100%]"
          >
            Accomplishment Report
          </span>
        </h1>
      </div>
    </section>
  )}

  <RecentAccomplishments />
</BaseLayout>
