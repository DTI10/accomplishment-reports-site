---
import BaseLayout from "../layouts/BaseLayout.astro"
---

<BaseLayout
  hero
  hideFooter
  title="Page not found"
  description="This page could not be found on the DTI Region 10 accomplishment report site."
>
  <section class="post-head relative flex min-h-[100svh] items-center overflow-hidden text-mist">
    <img
      src="/brand/dti-white.png"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute top-1/2 right-[6%] hidden h-[70%] -translate-y-1/2 opacity-[0.06] lg:block"
    />
    <div class="shell relative pt-36 pb-24 sm:pt-44 sm:pb-32">
      <p class="text-sm font-semibold tracking-[0.18em] text-dti-gold uppercase">Error 404</p>
      <h1 class="display mt-4 max-w-[16ch] text-[clamp(2.2rem,5vw,4rem)] text-white">
        This page isn’t here
      </h1>
      <p class="mt-6 max-w-[48ch] text-lg text-mist/75">
        The link may be old, or the story may have moved or been removed. Try the latest accomplishments, or start again from the home page.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href="/#accomplishments" class="btn bg-dti-gold text-navy-deep hover:bg-mist">See the latest accomplishments</a>
        <a href="/" class="btn border border-mist/30 text-mist hover:border-mist hover:bg-mist/10">Go to the home page</a>
      </div>
    </div>
  </section>
</BaseLayout>
