---
import PostView from '../../components/PostView.astro';
import { getPublishedPosts, type Post } from '../../lib/content';

export async function getStaticPaths() {
	const posts = await getPublishedPosts('articles');

	return posts.map((post) => ({
		params: { article: post.id },
		props: { post },
	}));
}

interface Props {
	post: Post;
}

const { post } = Astro.props;
---

<PostView post={post} />
