---
import { getProvinces, getSummary, PROVINCES, type Post } from "../lib/content"
import PostCard from "./PostCard.astro"

interface Props {
  posts: Post[]
  pageSize?: number
  emptyMessage?: string
  /** Prefix for the field ids, so several lists can sit on one page. */
  idPrefix?: string
  /** Hide the province dropdown (office pages are already one province). */
  hideProvince?: boolean
  /** Show the search / filter bar at all. */
  showFilters?: boolean
}

const {
  posts,
  pageSize = 6,
  emptyMessage = "No stories have been published yet.",
  idPrefix = "post",
  hideProvince = false,
  showFilters = true
} = Astro.props

// One row per post, with the values the filters and the search use
const rows = posts.map((post) => {
  const province = getProvinces(post.data)[0] ?? ""
  return {
    post,
    province,
    year: String(post.data.date.getUTCFullYear()),
    search: [
      post.data.title,
      getSummary(post),
      province,
      ...post.data.tags,
      "accomplishment"
    ]
      .join(" ")
      .toLowerCase()
  }
})

// Only offer provinces and years that at least one post uses
const provinces = PROVINCES.filter((name) =>
  rows.some((row) => row.province === name)
)
const years = [...new Set(rows.map((row) => row.year))].sort().reverse()

const field =
  "h-11 w-full rounded-[6px] border border-navy/20 bg-white px-3.5 text-[0.95rem] text-navy transition-colors placeholder:text-ink/45 hover:border-navy/40 focus-visible:border-navy"
---

<div data-posts data-page={pageSize}>
  {posts.length > 0 && showFilters && (
    <form
      class:list={[
        "mb-12 grid gap-3 sm:grid-cols-2",
        hideProvince ? "lg:grid-cols-[1fr_9rem_auto]" : "lg:grid-cols-[1fr_16rem_9rem_auto]"
      ]}
      role="search"
      aria-label="Filter stories"
      data-form
    >
      <div class="relative sm:col-span-2 lg:col-span-1">
        <label class="sr-only" for={`${idPrefix}-search`}>Search</label>
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          aria-hidden="true"
          class="pointer-events-none absolute top-1/2 left-3.5 -translate-y-1/2 text-ink/45"
        >
          <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2" />
          <path d="M16 16l4.5 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <input
          id={`${idPrefix}-search`}
          type="search"
          data-q
          placeholder="Search by title, topic or place"
          autocomplete="off"
          class:list={[field, "pl-10"]}
        />
      </div>

      {!hideProvince && (
        <div>
          <label class="sr-only" for={`${idPrefix}-province`}>Province or office</label>
          <select id={`${idPrefix}-province`} data-filter-province class={field}>
            <option value="">All provinces / offices</option>
            {provinces.map((name) => <option value={name}>{name}</option>)}
          </select>
        </div>
      )}

      <div>
        <label class="sr-only" for={`${idPrefix}-year`}>Year</label>
        <select id={`${idPrefix}-year`} data-filter-year class={field}>
          <option value="">All years</option>
          {years.map((year) => <option value={year}>{year}</option>)}
        </select>
      </div>

      <button
        type="button"
        data-clear
        hidden
        class="h-11 rounded-[6px] px-4 text-sm font-semibold text-navy underline decoration-navy/40 underline-offset-4 hover:decoration-navy"
      >
        Clear filters
      </button>
    </form>
  )}

  {posts.length === 0 ? (
    <p class="rounded-md border border-dashed border-navy/25 bg-white p-12 text-center text-ink/70">
      {emptyMessage}
    </p>
  ) : (
    <ul class="grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3" data-list>
      {rows.map((row) => (
        <li
          data-province={row.province}
          data-year={row.year}
          data-search={row.search}
        >
          <PostCard post={row.post} />
        </li>
      ))}
    </ul>
  )}

  <p class="mt-4 rounded-md border border-dashed border-navy/25 bg-white p-10 text-center text-ink/70" data-empty hidden>
    No stories match your search or filters.
  </p>

  <div class="mt-16 flex flex-wrap items-center gap-x-8 gap-y-5">
    <button
      type="button"
      class="btn border border-navy/30 text-navy hover:border-dti-blue hover:bg-dti-blue hover:text-mist"
      data-more
      hidden
    >
      Show more
    </button>
    <p class="text-sm text-ink/60 sm:ml-auto" data-status aria-live="polite"></p>
  </div>
</div>

<script>
  // Search + province/office + year filters, then "Show more" paging over the matches.
  // Without JavaScript every card stays visible.
  document.querySelectorAll<HTMLElement>("[data-posts]").forEach((root) => {
    const page = Number(root.dataset.page) || 6
    const items = [...root.querySelectorAll<HTMLElement>("[data-list] > li")]
    const form = root.querySelector<HTMLFormElement>("[data-form]")
    const q = root.querySelector<HTMLInputElement>("[data-q]")
    const province = root.querySelector<HTMLSelectElement>("[data-filter-province]")
    const year = root.querySelector<HTMLSelectElement>("[data-filter-year]")
    const clear = root.querySelector<HTMLButtonElement>("[data-clear]")
    const more = root.querySelector<HTMLButtonElement>("[data-more]")
    const status = root.querySelector<HTMLElement>("[data-status]")
    const empty = root.querySelector<HTMLElement>("[data-empty]")
    // nothing to filter when there are no posts at all (the page shows its own empty message)
    if (!more || !status || !empty || items.length === 0) return

    let limit = page

    const render = () => {
      const words = (q?.value ?? "").trim().toLowerCase().split(/\s+/).filter(Boolean)
      const matches = items.filter(
        (li) =>
          (!province?.value || li.dataset.province === province.value) &&
          (!year?.value || li.dataset.year === year.value) &&
          words.every((word) => (li.dataset.search ?? "").includes(word))
      )

      items.forEach((li) => (li.hidden = true))
      matches.slice(0, limit).forEach((li) => (li.hidden = false))

      const shown = Math.min(limit, matches.length)
      more.hidden = shown >= matches.length
      more.textContent = `Show ${matches.length - shown} more`
      status.textContent = matches.length
        ? `Showing ${shown} of ${matches.length}`
        : ""
      empty.hidden = matches.length > 0
      if (clear) clear.hidden = !(words.length || province?.value || year?.value)
      return matches
    }

    const reset = () => {
      limit = page
      render()
    }

    q?.addEventListener("input", reset)
    province?.addEventListener("change", reset)
    year?.addEventListener("change", reset)
    form?.addEventListener("submit", (event) => event.preventDefault())

    clear?.addEventListener("click", () => {
      if (q) q.value = ""
      if (province) province.value = ""
      if (year) year.value = ""
      reset()
      q?.focus()
    })

    more.addEventListener("click", () => {
      const before = limit
      limit = Infinity
      const matches = render()
      // move keyboard focus to the first newly revealed card
      matches?.[before]?.querySelector("a")?.focus()
    })

    render()
  })
</script>
