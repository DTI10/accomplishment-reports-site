---
import { getPostHref, getProvinces, getPublishedPosts } from "../lib/content"

const PAGE = 6
const MONTHS = [
  "Jan",
  "Feb",
  "Mar",
  "Apr",
  "May",
  "Jun",
  "Jul",
  "Aug",
  "Sep",
  "Oct",
  "Nov",
  "Dec"
]

const posts = [
  ...(await getPublishedPosts("articles")),
  ...(await getPublishedPosts("news"))
].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const items = posts.map((post) => {
  const d = post.data.date
  return {
    href: getPostHref(post),
    title: post.data.title,
    summary: post.data.description,
    image: post.data.image || post.data.gallery[0]?.image || undefined,
    iso: d.toISOString().slice(0, 10),
    day: d.getUTCDate(),
    month: `${MONTHS[d.getUTCMonth()]} ${d.getUTCFullYear()}`,
    type: post.collection === "news" ? "News" : "Article",
    provinces: getProvinces(post.data)
  }
})
---

<section id="news" class="bg-mist py-24 sm:py-32" data-news>
  <div class="shell">
    <div class="max-w-xl">
      <h2 class="display text-[clamp(2.2rem,4.5vw,3.6rem)] text-navy">
        News and accomplishments
      </h2>
      <p class="mt-5 text-ink/75">
        The latest news and accomplishments from the Department of Trade and
        Industry, Region 10.
      </p>
    </div>

    {items.length === 0 ? (
      <p class="mt-14 rounded-md border border-dashed border-dti-blue/30 p-12 text-center text-ink/60">
        No stories have been published yet.
      </p>
    ) : (
      <ul
        class="mt-14 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3"
        data-list
      >
        {items.map((u) => (
          <li>
            <a href={u.href} class="group block">
              <div class="relative">
                {u.image ? (
                  <img
                    src={u.image}
                    alt=""
                    loading="lazy"
                    class="aspect-[3/2] w-full rounded-md object-cover"
                  />
                ) : (
                  <div
                    class="aspect-[3/2] w-full rounded-md bg-mist-deep bg-[url('/brand/dti-rapid.png')] bg-[length:auto_46%] bg-center bg-no-repeat"
                    aria-hidden="true"
                  />
                )}
                <time
                  datetime={u.iso}
                  class="absolute bottom-[-1.75rem] left-4 flex min-w-16 flex-col items-center rounded-[3px] border-t-[3px] border-dti-gold bg-navy px-[0.7rem] pt-[0.55rem] pb-2 leading-none text-mist shadow-[0_0_0_3px_var(--color-mist),0_10px_20px_-10px_rgb(6_22_51/0.6)]"
                >
                  <span class="font-display text-[1.7rem] font-bold font-stretch-[100%] tracking-[-0.01em]">
                    {u.day}
                  </span>
                  <span class="mt-[0.4rem] border-t border-mist/22 pt-[0.4rem] text-[0.62rem] font-semibold tracking-[0.14em] whitespace-nowrap text-mist/80 uppercase">
                    {u.month}
                  </span>
                </time>
              </div>
              <div class="mt-10">
                <p class="mb-2 text-[0.7rem] font-semibold tracking-[0.18em] text-ink/55 uppercase">
                  {u.type}
                  {u.provinces.length > 0 && (
                    <span class="text-dti-blue">
                      {" "}
                      · {u.provinces.join(", ")}
                    </span>
                  )}
                </p>
                <h3 class="line-clamp-3 text-xl leading-snug font-semibold tracking-tight text-navy group-hover:underline group-focus-visible:underline decoration-navy decoration-1 underline-offset-4">
                  {u.title}
                </h3>
                {u.summary && (
                  <p class="mt-2 line-clamp-2 text-[0.975rem] leading-relaxed text-ink/65">
                    {u.summary}
                  </p>
                )}
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}

    <div class="mt-16 flex flex-wrap items-center gap-x-8 gap-y-5">
      <button
        type="button"
        class="btn border border-navy/30 text-navy hover:border-dti-blue hover:bg-dti-blue hover:text-mist"
        data-more
        hidden
      >
        Show more
      </button>
      <p
        class="text-sm text-ink/60 sm:ml-auto"
        data-status
        aria-live="polite"
      ></p>
    </div>
  </div>
</section>

<script define:vars={{ PAGE }}>
  // Reveal items page by page. Without JavaScript every card stays visible.
  const root = document.querySelector("[data-news]")
  const more = root?.querySelector("[data-more]")
  if (root && more) {
    const items = [...root.querySelectorAll("[data-list] > li")]
    const status = root.querySelector("[data-status]")
    const render = (expanded) => {
      items.forEach((li, i) => (li.hidden = !expanded && i >= PAGE))
      const shown = expanded ? items.length : Math.min(PAGE, items.length)
      more.hidden = shown === items.length
      more.textContent = `Show ${items.length - shown} more`
      status.textContent = `Showing ${shown} of ${items.length}`
    }
    more.addEventListener("click", () => {
      render(true)
      items[PAGE]?.querySelector("a")?.focus()
    })
    render(false)
  }
</script>
