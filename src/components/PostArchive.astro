---
import type { Post } from "../lib/content"
import PostCard from "./PostCard.astro"

interface Props {
  posts: Post[]
  title: string
  description: string
  eyebrow: string
  emptyMessage?: string
}

const {
  posts,
  title,
  description,
  eyebrow,
  emptyMessage = "No posts have been published yet."
} = Astro.props

const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort()
---

<section class="border-b border-[var(--color-border)] bg-gradient-to-b from-white to-[var(--color-bg)] pt-14 pb-8">
  <div class="mx-auto w-[min(100%-2rem,1200px)]">
    <p class="mb-3 inline-flex items-center gap-2.5 text-xs font-bold tracking-[0.14em] text-dti-red uppercase before:h-0.5 before:w-6 before:bg-current before:content-['']">
      {eyebrow}
    </p>
    <h1 class="mb-2 text-[clamp(2.2rem,4vw,3rem)] leading-tight tracking-[-0.02em]">
      {title}
    </h1>
    <p class="m-0 text-[var(--color-muted)]">{description}</p>
  </div>
</section>

<section class="py-14 max-sm:py-10">
  <div class="mx-auto w-[min(100%-2rem,1200px)]">
    {tags.length > 0 && (
      <ul class="mb-8 flex list-none flex-wrap gap-2 p-0" aria-label="Topics">
        {tags.map((tag) => (
          <li class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1 text-[0.78rem] font-semibold text-[var(--color-muted)]">
            {tag}
          </li>
        ))}
      </ul>
    )}

    {posts.length === 0 ? (
      <div class="rounded-[var(--radius-lg)] border border-dashed border-[var(--color-border)] bg-[var(--color-surface)] p-12 text-center">
        <h2>Nothing here yet</h2>
        <p>
          {emptyMessage} Sign in to the <a href="/admin/">content manager</a> to
          publish your first post.
        </p>
      </div>
    ) : (
      <div class="grid grid-cols-[repeat(auto-fill,minmax(290px,1fr))] gap-6">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    )}
  </div>
</section>
