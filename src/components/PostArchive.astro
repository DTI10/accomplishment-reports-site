---
import BaseLayout from "../layouts/BaseLayout.astro"
import type { Post } from "../lib/content"
import PostList from "./PostList.astro"

interface Props {
  posts: Post[]
  title: string
  description: string
  eyebrow: string
  emptyMessage?: string
}

const {
  posts,
  title,
  description,
  eyebrow,
  emptyMessage = "No posts have been published yet."
} = Astro.props

---

<BaseLayout hero title={title} description={description}>
  <header class="post-head text-mist">
    <div class="shell pt-32 pb-14 sm:pt-40 sm:pb-16">
      <p class="mb-4 text-[0.78rem] font-semibold tracking-[0.18em] text-dti-gold uppercase">
        {eyebrow}
      </p>
      <h1 class="display max-w-3xl text-[clamp(2.2rem,5vw,3.8rem)] text-white">
        {title}
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-mist/80">{description}</p>
    </div>
  </header>

  <section class="bg-mist py-14 sm:py-20">
    <div class="shell">
      <PostList posts={posts} pageSize={12} emptyMessage={emptyMessage} morph lead chips />
    </div>
  </section>
</BaseLayout>
