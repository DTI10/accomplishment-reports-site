---
import { navItems } from "../lib/nav"

const NATIONAL = "https://www.dti.gov.ph"
---

<header class="pointer-events-none fixed inset-x-0 top-3 z-50" data-nav>
  <nav
    class="pointer-events-auto mx-auto flex w-[calc(100%-2rem)] max-w-[76rem] items-center justify-between gap-4 rounded-[10px] bg-white/[0.94] px-3 py-2 shadow-[0_0_0_1px_rgb(10_31_68/0.08),0_14px_34px_-14px_rgb(6_22_51/0.55)] backdrop-blur-[14px] backdrop-saturate-[1.3] [view-transition-name:site-nav]"
    aria-label="Main"
  >
    <a
      href="/"
      class="flex items-center gap-3 rounded-sm"
      aria-label="DTI Region 10, home"
    >
      <img
        src="/brand/dti-rapid.png"
        alt=""
        width="40"
        height="40"
        class="h-10 w-auto"
      />
      <span class="hidden whitespace-nowrap text-sm leading-tight sm:block">
        <span class="block font-bold tracking-tight text-navy">Region 10</span>
        <span class="block text-[0.8rem] text-ink/60">Northern Mindanao</span>
      </span>
    </a>

    <!-- Wide screens: links in the bar, with dropdowns -->
    <ul class="hidden items-center gap-1 whitespace-nowrap text-[0.92rem] font-medium text-navy/85 xl:flex">
      {navItems.map((item) => (
        <li class:list={["relative", { group: item.children }]}>
          {item.children ? (
            <>
              <button
                type="button"
                class="flex items-center gap-1 rounded px-3 py-2 transition-colors hover:text-dti-blue group-hover:text-dti-blue"
                aria-expanded="false"
                aria-haspopup="true"
                data-drop
              >
                {item.label}
                <svg
                  viewBox="0 0 12 8"
                  width="10"
                  height="7"
                  aria-hidden="true"
                >
                  <path
                    d="M1 1.5l5 5 5-5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                  />
                </svg>
              </button>
              <ul
                class="pointer-events-none invisible absolute top-full left-0 z-10 mt-[0.85rem] min-w-60 translate-y-[-0.4rem] rounded-[10px] bg-white p-[0.4rem] opacity-0 shadow-[0_0_0_1px_rgb(10_31_68/0.08),0_18px_40px_-14px_rgb(6_22_51/0.5)] transition-[opacity,transform,visibility] duration-200 ease-[var(--ease-out-quint)] before:absolute before:inset-x-0 before:-top-4 before:h-4 before:content-[''] group-hover:pointer-events-auto group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:pointer-events-auto group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 data-[open]:pointer-events-auto data-[open]:visible data-[open]:translate-y-0 data-[open]:opacity-100"
                data-drop-panel
              >
                {item.children.map((c) => (
                  <li>
                    <a
                      class="block rounded-md px-[0.8rem] py-[0.65rem] text-[0.95rem] font-medium text-navy hover:bg-navy/[0.06] hover:text-dti-blue"
                      href={c.href}
                      target={c.external ? "_blank" : undefined}
                      rel={c.external ? "noopener" : undefined}
                    >
                      {c.label}
                    </a>
                  </li>
                ))}
              </ul>
            </>
          ) : (
            <a
              href={item.href}
              class="block rounded px-3 py-2 transition-colors hover:text-dti-blue"
            >
              {item.label}
            </a>
          )}
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <a
        href={NATIONAL}
        target="_blank"
        rel="noopener"
        class="hidden items-center gap-2.5 rounded-md bg-navy px-[1.35rem] py-2.5 text-sm font-semibold whitespace-nowrap text-white transition-colors hover:bg-dti-blue xl:inline-flex"
      >
        DTI National
      </a>
      <button
        type="button"
        class="group grid size-11 place-items-center rounded-md bg-navy text-white xl:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-btn
      >
        <span class="relative h-[0.85rem] w-[1.15rem]" aria-hidden="true">
          <span class="absolute top-0 left-0 h-0.5 w-full rounded-[2px] bg-current transition-[transform,opacity] duration-300 ease-[var(--ease-out-quint)] group-aria-expanded:translate-y-[calc(0.425rem-1px)] group-aria-expanded:rotate-45"></span>
          <span class="absolute top-[calc(50%-1px)] left-0 h-0.5 w-full rounded-[2px] bg-current transition-[transform,opacity] duration-300 ease-[var(--ease-out-quint)] group-aria-expanded:opacity-0"></span>
          <span class="absolute bottom-0 left-0 h-0.5 w-full rounded-[2px] bg-current transition-[transform,opacity] duration-300 ease-[var(--ease-out-quint)] group-aria-expanded:-translate-y-[calc(0.425rem-1px)] group-aria-expanded:-rotate-45"></span>
        </span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="pointer-events-auto mx-auto mt-[0.6rem] max-h-[calc(100svh-6rem)] w-[calc(100%-2rem)] max-w-[76rem] animate-[menu-in_0.3s_var(--ease-out-quint)] overflow-y-auto rounded-[10px] bg-white p-3 shadow-[0_0_0_1px_rgb(10_31_68/0.08),0_14px_34px_-14px_rgb(6_22_51/0.55)] motion-reduce:animate-none xl:hidden"
    data-menu
    hidden
  >
    <ul class="[&>li+li]:border-t [&>li+li]:border-navy/10">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            data-menu-link={item.children ? undefined : ""}
            class="block rounded px-3 py-[0.95rem] text-[1.05rem] font-bold tracking-[-0.005em] text-navy hover:bg-navy/5"
          >
            {item.label}
          </a>
          {item.children && (
            <ul class="px-5 pb-[0.6rem]">
              {item.children.map((c) => (
                <li>
                  <a
                    class="block rounded px-3 py-2 text-[0.98rem] text-ink/[0.68] hover:bg-navy/5"
                    href={c.href}
                    data-menu-link
                  >
                    {c.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
    <a
      href={NATIONAL}
      target="_blank"
      rel="noopener"
      class="mt-4 flex w-full items-center justify-center gap-2.5 rounded-md bg-navy px-[1.35rem] py-[0.85rem] font-semibold text-white transition-colors hover:bg-dti-blue"
    >
      DTI National
    </a>
  </div>
</header>

<script>
  const wrap = document.querySelector<HTMLElement>("[data-nav]")
  const btn = document.querySelector<HTMLButtonElement>("[data-menu-btn]")
  const panel = document.querySelector<HTMLElement>("[data-menu]")

  const setOpen = (open: boolean) => {
    if (!btn || !panel) return
    panel.hidden = !open
    btn.setAttribute("aria-expanded", String(open))
    btn.setAttribute("aria-label", open ? "Close menu" : "Open menu")
  }
  btn?.addEventListener("click", () => setOpen(panel?.hidden ?? false))
  panel
    ?.querySelectorAll("[data-menu-link]")
    .forEach((a) => a.addEventListener("click", () => setOpen(false)))

  // Desktop dropdowns also open by click/tap (touch laptops), close on Esc or outside click
  const drops = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-drop]")
  )
  const closeDrops = (except?: Element) =>
    drops.forEach((b) => {
      if (b === except) return
      b.setAttribute("aria-expanded", "false")
      b.nextElementSibling?.removeAttribute("data-open")
    })
  drops.forEach((b) =>
    b.addEventListener("click", () => {
      const open = b.getAttribute("aria-expanded") !== "true"
      closeDrops(b)
      b.setAttribute("aria-expanded", String(open))
      b.nextElementSibling?.toggleAttribute("data-open", open)
    })
  )

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return
    closeDrops()
    if (panel && !panel.hidden) {
      setOpen(false)
      btn?.focus()
    }
  })
  document.addEventListener("click", (e) => {
    const t = e.target as Node
    if (!wrap?.contains(t)) {
      closeDrops()
      if (panel && !panel.hidden) setOpen(false)
    }
  })
  window
    .matchMedia("(min-width: 1280px)")
    .addEventListener("change", (e) => e.matches && setOpen(false))
</script>
