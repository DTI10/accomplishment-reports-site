---
import BaseLayout from "../layouts/BaseLayout.astro"
import { Badge } from "./ui/badge"
import {
  formatPostDate,
  getPostHref,
  altFromFilename,
  getListHref,
  getProvinces,
  getSummary,
  getPublishedPosts,
  getSectionForCollection,
  type Post,
  type PostCollection
} from "../lib/content"
import { photoSide, placePhotos, renderStoryBlocks } from "../lib/storyBody"
import { getPrograms, programHref } from "../lib/programs"

interface Props {
  post: Post
}

const { post } = Astro.props
const {
  title,
  date,
  image,
  author,
  photos,
  programs: programSlugs
} = post.data

// Story text, cleaned of pasted Word/Docs artefacts and split into blocks
const slugify = (text: string) =>
  text
    .toLowerCase()
    .replace(/&[a-z]+;|<[^>]+>/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "")
const toc: { depth: number; text: string; slug: string }[] = []
const blocks = renderStoryBlocks(post.body ?? "").map((block) => ({
  ...block,
  html: block.html.replace(
    /<h([23])>([\s\S]*?)<\/h[23]>/,
    (_match, depth: string, inner: string) => {
      const text = inner.replace(/<[^>]+>/g, "").trim()
      const slug = slugify(text)
      toc.push({ depth: Number(depth), text, slug })
      return `<h${depth} id="${slug}">${inner}</h${depth}>`
    }
  )
}))

// Extra photos: where each one goes (-1 = top), alternating left / right
const slots = placePhotos(blocks, photos)
const placed = new Map<
  number,
  { image: string; size: string; side: "left" | "right"; caption?: string; n: number }[]
>()
photos.forEach((photo, k) => {
  const list = placed.get(slots[k]) ?? []
  list.push({
    image: photo.image,
    size: photo.size,
    side: photoSide(photo.side, k),
    caption: photo.caption?.trim(),
    n: k + 2
  })
  placed.set(slots[k], list)
})

const collection = post.collection as PostCollection
const section = getSectionForCollection(collection)
const sectionLabel = "Accomplishments"
const typeLabel = "Accomplishment"

const summary = getSummary(post)
const provinces = getProvinces(post.data)
// The CMS stores program slugs in the relation. Shown under the title as "Part of <program>", linked to its page.
const allPrograms = await getPrograms()
const programs = (programSlugs ?? []).map((slug) => {
  const program = allPrograms.find((p) => p.slug === slug)
  return { slug, name: program?.name ?? slug, exists: Boolean(program) }
})
const formattedDate = formatPostDate(date, "long")
const altText = altFromFilename(image, title)
const photo = image || undefined

const wordCount = (post.body ?? "").trim().split(/\s+/).filter(Boolean).length
const readingTime = Math.max(1, Math.ceil(wordCount / 220))

// "More" band: the newest other posts of the same kind
const allPosts = await getPublishedPosts(collection)
const more = allPosts.filter((p) => p.id !== post.id).slice(0, 3)

const wrap = "mx-auto w-full max-w-[70rem] px-4 sm:px-8"
---

<BaseLayout
  hero
  title={title}
  description={summary || title}
  image={image}
>
  <article>
    <header class="post-head text-mist">
      <div
        class:list={[
          wrap,
          "grid items-center gap-10 pt-24 pb-14 sm:pt-32 lg:grid-cols-[1.1fr_1fr] lg:gap-14 lg:pb-16"
        ]}
      >
        <div>
          <a
            href={getListHref(collection)}
            class="inline-flex items-center gap-2 text-sm font-semibold text-mist/75 hover:text-white"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path
                d="M15 5l-7 7 7 7"
                fill="none"
                stroke="currentColor"
                stroke-width="2"></path>
            </svg>
            All {sectionLabel.toLowerCase()}
          </a>

          <div class="mt-8 flex flex-wrap items-center gap-2">
            <Badge variant="news">{typeLabel}</Badge>
            {provinces.map((p) => <Badge variant="outline">{p}</Badge>)}
          </div>

          <h1
            style={`view-transition-name: st-${collection}-${post.id}; view-transition-class: story-title;`}
            class="display mt-5 text-[clamp(1.6rem,2.4vw,2.25rem)] leading-[1.12] tracking-[-0.015em] text-balance text-white"
          >
            {title}
          </h1>

          {
            programs.length > 0 && (
              <p class="mt-5 text-[0.95rem] leading-relaxed text-mist/70">
                Part of{" "}
                {programs.map((program, i) => (
                  <>
                    {i > 0 && (i === programs.length - 1 ? " and " : ", ")}
                    {program.exists ? (
                      <a
                        href={programHref(program.slug)}
                        class="group/program inline-flex items-center gap-1 font-semibold text-white underline decoration-dti-gold/70 decoration-1 underline-offset-4 transition-colors hover:decoration-dti-gold"
                      >
                        {program.name}
                        <svg
                          viewBox="0 0 16 16"
                          width="14"
                          height="14"
                          aria-hidden="true"
                          class="text-dti-gold transition-transform duration-200 group-hover/program:translate-x-0.5 motion-reduce:transition-none"
                        >
                          <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </a>
                    ) : (
                      <span class="font-semibold text-white">{program.name}</span>
                    )}
                  </>
                ))}
              </p>
            )
          }
        </div>

        <figure>
          <div class="photo-notch">
            {
              photo ? (
                <img
                  src={photo}
                  alt={altText}
                  style={`view-transition-name: sp-${collection}-${post.id}; view-transition-class: story-photo;`}
                  class="block aspect-[4/3] w-full rounded-[10px] object-cover"
                />
              ) : (
                <div
                  class="fh-fallback relative aspect-[4/3] w-full overflow-hidden rounded-[10px] border border-mist/10"
                  aria-hidden="true"
                />
              )
            }
            <div class="notch">
              <span class="notch-row">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                  <rect
                    x="3.5"
                    y="5"
                    width="17"
                    height="15.5"
                    rx="2"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"></rect>
                  <path
                    d="M3.5 10h17M8 3v4M16 3v4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"></path>
                </svg>
                <time datetime={date.toISOString().slice(0, 10)}>
                  {formattedDate}
                </time>
              </span>
              <span class="notch-row">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                  <path
                    d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"></path>
                  <circle
                    cx="12"
                    cy="10"
                    r="2.3"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"></circle>
                </svg>
                {provinces.length > 0 ? provinces.join(", ") : "DTI Region 10"}
              </span>
            </div>
          </div>
        </figure>
      </div>
    </header>

    <div class:list={[wrap, "pt-14 sm:pt-16"]}>
      <div class="grid gap-12">
        <div class="min-w-0">
          <div class="post-body">
            {
              (placed.get(-1) ?? []).map((ph) => (
                <figure class:list={["post-photo", `size-${ph.size}`, `side-${ph.side}`]}>
                  <img src={ph.image} alt={altFromFilename(ph.image, title)} loading="lazy" />
                  {ph.caption && <figcaption>{ph.caption}</figcaption>}
                </figure>
              ))
            }
            {
              blocks.map((block, i) => (
                <>
                  <Fragment set:html={block.html} />
                  {(placed.get(i) ?? []).map((ph) => (
                    <figure class:list={["post-photo", `size-${ph.size}`, `side-${ph.side}`]}>
                      <img src={ph.image} alt={altFromFilename(ph.image, title)} loading="lazy" />
                      {ph.caption && <figcaption>{ph.caption}</figcaption>}
                    </figure>
                  ))}
                </>
              ))
            }
          </div>

          <p class="mt-10 clear-both border-t border-navy/15 pt-5 text-sm text-ink/60">
            {author && (
              <>
                By <span class="font-semibold text-navy">{author}</span>
                <span aria-hidden="true"> · </span>
              </>
            )}
            {readingTime} min read
          </p>
        </div>

      </div>
    </div>
  </article>

  {
    more.length > 0 && (
      <nav
        class="mt-20 bg-mist-deep/60 sm:mt-28"
        aria-label={`More ${sectionLabel.toLowerCase()}`}
      >
        <div class:list={[wrap, "py-16 sm:py-20"]}>
          <div class="flex flex-wrap items-end justify-between gap-6">
            <h2 class="display text-[clamp(1.7rem,3vw,2.4rem)] text-navy">
              More {sectionLabel.toLowerCase()}
            </h2>
            <a
              href={getListHref(collection)}
              class="font-semibold text-navy underline decoration-navy/40 underline-offset-[6px] hover:decoration-navy"
            >
              See all {sectionLabel.toLowerCase()}
            </a>
          </div>
          <ul class="mt-10 grid gap-x-10 gap-y-9 md:grid-cols-2 lg:grid-cols-3">
            {more.map((item) => {
              const thumb = item.data.image
              const itemProvinces = getProvinces(item.data)
              return (
                <li>
                  <a
                    href={getPostHref(item)}
                    class="more-link group grid grid-cols-[7.5rem_1fr] items-start gap-5 sm:grid-cols-[8.5rem_1fr]"
                  >
                    {thumb ? (
                      <img
                        src={thumb}
                        alt=""
                        loading="lazy"
                        class="aspect-[4/3] w-full rounded-[2px] border-[3px] border-navy object-cover"
                      />
                    ) : (
                      <span
                        class="fh-fallback relative block aspect-[4/3] w-full overflow-hidden rounded-[2px] border-[3px] border-navy"
                        aria-hidden="true"
                      />
                    )}
                    <span>
                      <span class="block text-[0.7rem] font-semibold tracking-[0.16em] text-ink/55 uppercase">
                        Accomplishment
                        {itemProvinces.length > 0 && (
                          <span class="text-dti-blue">
                            {" · "}
                            {itemProvinces.join(", ")}
                          </span>
                        )}
                      </span>
                      <span class="more-title mt-2 text-lg leading-snug font-semibold tracking-tight text-navy">
                        {item.data.title}
                      </span>
                      <span class="mt-1 block text-sm text-ink/60">
                        {formatPostDate(item.data.date, "long")}
                      </span>
                    </span>
                  </a>
                </li>
              )
            })}
          </ul>
        </div>
      </nav>
    )
  }
</BaseLayout>
