---
import { render } from "astro:content"
import BaseLayout from "../layouts/BaseLayout.astro"
import ImageCarousel from "./ImageCarousel.astro"
import {
  formatPostDate,
  getPostHref,
  getPublishedPosts,
  getRelatedPosts,
  getSectionForCollection,
  type Post,
  type PostCollection
} from "../lib/content"

interface Props {
  post: Post
}

const { post } = Astro.props
const {
  title,
  date,
  description,
  author,
  image,
  image_alt,
  gallery,
  tags,
  program,
  event,
  stats,
  partners,
  attachments,
  contact
} = post.data
const { Content, headings } = await render(post)

const collection = post.collection as PostCollection
const section = getSectionForCollection(collection)
const sectionLabel = section === "news" ? "News" : "Articles"

const allPosts = await getPublishedPosts(collection)
const currentIndex = allPosts.findIndex((item) => item.id === post.id)
const previous = allPosts[currentIndex + 1]
const next = allPosts[currentIndex - 1]

const formattedDate = formatPostDate(date, "long")
const altText = image_alt ?? title

const relatedPosts = await getRelatedPosts(post)
const hasContact = Boolean(
  contact?.name || contact?.role || contact?.email || contact?.phone
)

const formatEventDate = (value: Date) => {
  const hasTime = value.getHours() !== 0 || value.getMinutes() !== 0
  return new Intl.DateTimeFormat("en-PH", {
    dateStyle: "medium",
    ...(hasTime ? { timeStyle: "short" as const } : {})
  }).format(value)
}

const wordCount = (post.body ?? "").trim().split(/\s+/).filter(Boolean).length
const readingTime = Math.max(1, Math.ceil(wordCount / 220))

const toc = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3
)
---

<BaseLayout title={title} description={description ?? title} image={image}>
  <article>
    <header class="border-b border-[var(--color-border)] bg-gradient-to-b from-white to-[var(--color-bg)] pt-12 pb-10">
      <div class="mx-auto w-[min(100%-2rem,1200px)] max-w-[820px]">
        <a
          class="mb-[1.4rem] inline-block text-[0.86rem] font-bold"
          href={`/${section}/`}
        >
          ← All {sectionLabel.toLowerCase()}
        </a>

        <div class="flex flex-wrap items-center gap-2 text-[0.82rem] font-semibold tracking-[0.03em] text-[var(--color-muted)] uppercase">
          <span
            class:list={[
              "rounded-full px-[0.6rem] py-[0.2rem] text-[0.68rem] font-extrabold",
              collection === "news"
                ? "bg-[var(--color-accent-soft)] text-[#7a5800]"
                : "bg-[#eaf1fb] text-[var(--color-primary)]"
            ]}
          >
            {sectionLabel}
          </span>
          {program && (
            <span class="rounded-full border border-[var(--color-border)] px-[0.6rem] py-[0.2rem] text-[0.68rem] font-extrabold text-[var(--color-muted)]">
              {program}
            </span>
          )}
          <time datetime={date.toISOString()}>{formattedDate}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime} min read</span>
          {author && (
            <>
              <span aria-hidden="true">·</span>
              <span>{author}</span>
            </>
          )}
        </div>

        <h1 class="mt-[0.7rem] mb-[0.9rem] text-[clamp(2.1rem,4.5vw,3.2rem)] tracking-[-0.025em]">
          {title}
        </h1>
        {description && (
          <p class="m-0 max-w-2xl text-[1.12rem] text-[var(--color-muted)]">
            {description}
          </p>
        )}

        {event && (
          <div class="mt-[1.6rem] rounded-[var(--radius-md)] border border-[var(--color-border)] border-l-4 border-l-[var(--color-primary)] bg-[var(--color-surface)] px-[1.4rem] py-[1.2rem]">
            <p class="mt-0 mb-[0.6rem] text-[0.72rem] font-bold tracking-[0.08em] text-[var(--color-muted)] uppercase">
              Event details
            </p>
            <dl class="m-0 flex flex-wrap gap-x-[2.2rem] gap-y-[0.4rem]">
              <div class="flex flex-col gap-[0.15rem]">
                <dt class="text-[0.72rem] font-bold tracking-[0.06em] text-[var(--color-muted)] uppercase">
                  When
                </dt>
                <dd class="m-0 font-semibold">
                  <time datetime={event.start.toISOString()}>
                    {formatEventDate(event.start)}
                  </time>
                  {event.end && (
                    <>
                      {" – "}
                      <time datetime={event.end.toISOString()}>
                        {formatEventDate(event.end)}
                      </time>
                    </>
                  )}
                </dd>
              </div>
              {event.venue && (
                <div class="flex flex-col gap-[0.15rem]">
                  <dt class="text-[0.72rem] font-bold tracking-[0.06em] text-[var(--color-muted)] uppercase">
                    Where
                  </dt>
                  <dd class="m-0 font-semibold">{event.venue}</dd>
                </div>
              )}
            </dl>
            {event.registration_url && (
              <a
                class="mt-[0.9rem] inline-block text-[0.9rem] font-bold"
                href={event.registration_url}
              >
                Register <span aria-hidden="true">→</span>
              </a>
            )}
          </div>
        )}

        {tags.length > 0 && (
          <ul
            class="mt-[1.4rem] flex list-none flex-wrap gap-[0.45rem] p-0"
            aria-label="Tags"
          >
            {tags.map((tag) => (
              <li class="rounded-full bg-[var(--color-accent-soft)] px-[0.7rem] py-1 text-[0.72rem] font-bold tracking-[0.04em] text-[#7a5800] uppercase">
                {tag}
              </li>
            ))}
          </ul>
        )}
      </div>
    </header>

    {image && (
      <div class="mx-auto mt-8 w-[min(100%-2rem,1200px)]">
        <img
          class="max-h-[520px] w-full rounded-[var(--radius-lg)] object-cover shadow-[var(--shadow-md)]"
          src={image}
          alt={altText}
        />
      </div>
    )}

    <div class="mx-auto grid w-[min(100%-2rem,1200px)] gap-8 pt-12 min-[901px]:grid-cols-[minmax(0,1fr)_240px] min-[901px]:gap-14">
      <div class="min-w-0">
        <div class="prose">
          <Content />
        </div>

        {stats.length > 0 && (
          <section
            class="mt-10 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[#f4f8fd] p-6"
            aria-labelledby="stats-heading"
          >
            <h2 class="mt-0 mb-4 text-[1.3rem]" id="stats-heading">
              Key figures
            </h2>
            <dl class="m-0 grid grid-cols-[repeat(auto-fit,minmax(150px,1fr))] gap-[1.2rem]">
              {stats.map((stat) => (
                <div>
                  <dt class="text-[0.78rem] font-bold tracking-[0.05em] text-[var(--color-muted)] uppercase">
                    {stat.label}
                  </dt>
                  <dd class="mt-[0.3rem] mb-0 text-[1.8rem] leading-none font-extrabold text-[var(--color-primary)]">
                    {stat.value}
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        {gallery.length > 0 && (
          <section class="mt-12" aria-labelledby="gallery-heading">
            <h2 class="mb-4 text-[1.3rem]" id="gallery-heading">
              Gallery
            </h2>
            <ImageCarousel
              items={gallery}
              label={`Photo gallery for ${title}`}
            />
          </section>
        )}

        {(partners.length > 0 || attachments.length > 0 || hasContact) && (
          <section
            class="mt-12 border-t border-[var(--color-border)] pt-8 [&>div+div]:mt-[1.4rem]"
            aria-labelledby="info-heading"
          >
            <h2 class="mt-0 mb-4 text-[1.3rem]" id="info-heading">
              More information
            </h2>

            {partners.length > 0 && (
              <div>
                <h3 class="mt-0 mb-[0.4rem] text-[0.78rem] tracking-[0.07em] text-[var(--color-muted)] uppercase">
                  Partners
                </h3>
                <ul class="m-0 flex list-none flex-wrap gap-[0.45rem] p-0">
                  {partners.map((partner) => (
                    <li class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-[0.7rem] py-1 text-[0.85rem]">
                      {partner}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {attachments.length > 0 && (
              <div>
                <h3 class="mt-0 mb-[0.4rem] text-[0.78rem] tracking-[0.07em] text-[var(--color-muted)] uppercase">
                  Downloads
                </h3>
                <ul class="m-0 flex list-none flex-col gap-[0.3rem] p-0">
                  {attachments.map((attachment) => (
                    <li>
                      <a href={attachment.file} download>
                        {attachment.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {hasContact && (
              <div>
                <h3 class="mt-0 mb-[0.4rem] text-[0.78rem] tracking-[0.07em] text-[var(--color-muted)] uppercase">
                  Contact
                </h3>
                {contact?.name && (
                  <p class="m-0">
                    {contact.name}
                    {contact.role && <span>, {contact.role}</span>}
                  </p>
                )}
                {!contact?.name && contact?.role && (
                  <p class="m-0">{contact.role}</p>
                )}
                {(contact?.email || contact?.phone) && (
                  <p class="m-0">
                    {contact?.email && (
                      <a href={`mailto:${contact.email}`}>{contact.email}</a>
                    )}
                    {contact?.email && contact?.phone && (
                      <span aria-hidden="true"> · </span>
                    )}
                    {contact?.phone && (
                      <a href={`tel:${contact.phone.replace(/[^\d+]/g, "")}`}>
                        {contact.phone}
                      </a>
                    )}
                  </p>
                )}
              </div>
            )}
          </section>
        )}

        {relatedPosts.length > 0 && (
          <aside
            class="mt-12 rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface)] px-6 py-[1.4rem]"
            aria-labelledby="related-heading"
          >
            <h2 class="mt-0 mb-[0.8rem] text-[1.1rem]" id="related-heading">
              Read next
            </h2>
            <ul class="m-0 grid list-none gap-[0.9rem] p-0">
              {relatedPosts.map((relatedPost) => (
                <li>
                  <a href={getPostHref(relatedPost)}>
                    {relatedPost.data.title}
                  </a>
                  {relatedPost.data.description && (
                    <p class="mt-[0.2rem] mb-0 text-[0.88rem] text-[var(--color-muted)]">
                      {relatedPost.data.description}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </aside>
        )}

        <nav
          class="mt-14 grid grid-cols-2 gap-4 border-t border-[var(--color-border)] pt-8 max-[560px]:grid-cols-1"
          aria-label={`More ${sectionLabel.toLowerCase()}`}
        >
          {previous ? (
            <a
              class="flex flex-col gap-[0.3rem] rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface)] px-[1.2rem] py-4 hover:border-[#b9c9e5] hover:no-underline"
              href={getPostHref(previous)}
            >
              <span class="text-[0.72rem] font-bold tracking-[0.06em] text-[var(--color-muted)] uppercase">
                Previous
              </span>
              <strong class="text-[0.92rem] text-[var(--color-text)]">
                {previous.data.title}
              </strong>
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a
              class="flex flex-col gap-[0.3rem] rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface)] px-[1.2rem] py-4 text-right hover:border-[#b9c9e5] hover:no-underline max-[560px]:text-left"
              href={getPostHref(next)}
            >
              <span class="text-[0.72rem] font-bold tracking-[0.06em] text-[var(--color-muted)] uppercase">
                Next
              </span>
              <strong class="text-[0.92rem] text-[var(--color-text)]">
                {next.data.title}
              </strong>
            </a>
          ) : (
            <span />
          )}
        </nav>
      </div>

      {toc.length > 1 && (
        <aside
          class="static order-first rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface)] px-[1.3rem] py-[1.2rem] text-[0.85rem] min-[901px]:sticky min-[901px]:top-[100px] min-[901px]:order-none min-[901px]:self-start"
          aria-labelledby="toc-heading"
        >
          <h2
            class="mt-0 mb-[0.7rem] text-[0.75rem] tracking-[0.08em] text-[var(--color-muted)] uppercase"
            id="toc-heading"
          >
            On this page
          </h2>
          <ol class="m-0 list-none p-0 [&>li+li]:mt-2">
            {toc.map((heading) => (
              <li
                class:list={{
                  "pl-[0.9rem] text-[0.8rem]": heading.depth === 3
                }}
              >
                <a
                  class="text-[var(--color-muted)] hover:text-[var(--color-primary)] hover:no-underline"
                  href={`#${heading.slug}`}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </aside>
      )}
    </div>
  </article>
</BaseLayout>
