---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div class="footer-brand">
			<span class="footer-mark" aria-hidden="true">DTI</span>
			<div>
				<strong>DTI Accomplishments</strong>
				<p>Documenting the work, milestones, and people behind our programs.</p>
			</div>
		</div>

		<nav class="footer-links" aria-label="Footer navigation">
			<div>
				<span>Explore</span>
				<a href="/">Home</a>
				<a href="/articles">Articles</a>
				<a href="/news">News</a>
				<a href="/admin/">Content Manager</a>
			</div>
			<div>
				<span>Connect</span>
				<a href="https://www.dti.gov.ph" rel="noopener" target="_blank">DTI Website</a>
				<a href="https://www.facebook.com/DTIPhilippines" rel="noopener" target="_blank">Facebook</a>
			</div>
		</nav>
	</div>

	<div class="container footer-bottom">
		<p>&copy; {year} Department of Trade and Industry. All rights reserved.</p>
		<p>Built with Astro &amp; Sveltia CMS.</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 4rem;
		padding-top: 3rem;
		background: #0d1a31;
		color: #b9c4d8;
	}

	.footer-grid {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 2rem;
		padding-bottom: 2.5rem;
	}

	.footer-brand {
		display: flex;
		gap: 0.9rem;
		max-width: 380px;
	}

	.footer-brand strong {
		color: #fff;
		font-size: 1.05rem;
	}

	.footer-brand p {
		margin: 0.35rem 0 0;
		font-size: 0.9rem;
		color: #8d9bb5;
	}

	.footer-mark {
		display: grid;
		place-items: center;
		width: 42px;
		height: 42px;
		flex: 0 0 auto;
		border-radius: 12px;
		background: var(--color-primary);
		color: #fff;
		font-size: 0.8rem;
		font-weight: 800;
	}

	.footer-links {
		display: flex;
		gap: 3rem;
	}

	.footer-links div {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.footer-links span {
		margin-bottom: 0.25rem;
		color: #fff;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.footer-links a {
		color: #b9c4d8;
		font-size: 0.9rem;
	}

	.footer-bottom {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem;
		padding-block: 1.25rem;
		border-top: 1px solid rgb(255 255 255 / 10%);
		font-size: 0.8rem;
		color: #7d8ba6;
	}

	.footer-bottom p {
		margin: 0;
	}
</style>
