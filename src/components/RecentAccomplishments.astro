---
import { getPublishedPosts } from "../lib/content"
import PostList from "./PostList.astro"

// Newest first
const posts = await getPublishedPosts("articles")
---

<section id="accomplishments" class="bg-mist py-24 sm:py-32">
  <div class="shell">
    <div class="max-w-xl">
      <h2 class="display text-[clamp(2.2rem,4.5vw,3.6rem)] text-navy">
        Accomplishments
      </h2>
      <p class="mt-5 text-ink/75">
        The latest accomplishments from the Department of Trade and Industry,
        Region 10.
      </p>
    </div>

    <div class="mt-14">
      <PostList posts={posts} pageSize={6} />
    </div>
  </div>
</section>
