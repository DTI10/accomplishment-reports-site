---
import { formatPostDate, getPostHref, type Post } from '../lib/content';

interface Props {
	post: Post;
	featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, date, description, image, tags } = post.data;

const href = getPostHref(post);
const typeLabel = post.collection === 'news' ? 'News' : 'Article';
const fullDate = formatPostDate(date, 'long');
---

<article class:list={['post-card', { 'post-card--featured': featured }]}>
	<a class="card-media" href={href} aria-hidden="true" tabindex="-1">
		{image ? <img src={image} alt="" loading="lazy" /> : <div class="card-placeholder" />}
	</a>

	<div class="card-body">
		<p class="card-meta">
			<span class="card-type">{typeLabel}</span>
			<time datetime={date.toISOString()}>{fullDate}</time>
		</p>

		<h3 class="card-title">
			<a href={href}>{title}</a>
		</h3>

		{description && <p class="card-excerpt">{description}</p>}

		<a class="card-link" href={href}>Read full story</a>
	</div>
</article>

<style>
	.post-card {
		display: flex;
		flex-direction: column;
		background: transparent;
	}

	.card-media {
		display: block;
		aspect-ratio: 3 / 2;
		overflow: hidden;
		background: var(--dti-navy);
	}

	.card-media img,
	.card-placeholder {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.card-placeholder {
		background: var(--dti-navy);
	}

	.card-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.55rem;
		padding-top: 1rem;
	}

	.card-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin: 0;
		color: var(--color-muted);
		font-size: 0.85rem;
	}

	.card-type {
		color: var(--dti-red);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-size: 0.78rem;
	}

	.card-type::after {
		content: '|';
		margin-left: 0.6rem;
		color: var(--color-border);
	}

	.card-title {
		margin: 0;
		font-size: 1.3rem;
		line-height: 1.3;
	}

	.card-title a {
		color: var(--dti-navy);
	}

	.card-title a:hover {
		color: var(--dti-blue);
		text-decoration: underline;
	}

	.card-excerpt {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		margin: 0;
		overflow: hidden;
		color: var(--color-muted);
		font-size: 0.98rem;
	}

	.card-link {
		margin-top: auto;
		padding-top: 0.4rem;
		font-size: 0.9rem;
		font-weight: 600;
	}

	.post-card--featured .card-title {
		font-size: 1.9rem;
	}
</style>
