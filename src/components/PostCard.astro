---
import { formatPostDate, getPostHref, type Post } from "../lib/content"

interface Props {
  post: Post
  featured?: boolean
}

const { post, featured = false } = Astro.props
const { title, date, description, image, tags } = post.data

const href = getPostHref(post)
const typeLabel = post.collection === "news" ? "News" : "Article"
const fullDate = formatPostDate(date, "long")
---

<article class="flex flex-col bg-transparent">
  <a
    class="block aspect-[3/2] overflow-hidden bg-navy"
    href={href}
    aria-hidden="true"
    tabindex="-1"
  >
    {image ? (
      <img class="size-full object-cover" src={image} alt="" loading="lazy" />
    ) : (
      <div class="size-full bg-navy" />
    )}
  </a>

  <div class="flex flex-1 flex-col gap-[0.55rem] pt-4">
    <p class="m-0 flex flex-wrap gap-2.5 text-[0.85rem] text-[var(--color-muted)]">
      <span class="text-[0.78rem] font-bold tracking-[0.06em] text-dti-red uppercase after:ml-2.5 after:text-[var(--color-border)] after:content-['|']">
        {typeLabel}
      </span>
      <time datetime={date.toISOString()}>{fullDate}</time>
    </p>

    <h3
      class:list={[
        "m-0 leading-[1.3]",
        featured ? "text-[1.9rem]" : "text-[1.3rem]"
      ]}
    >
      <a class="text-navy hover:text-dti-blue hover:underline" href={href}>
        {title}
      </a>
    </h3>

    {description && (
      <p class="m-0 line-clamp-3 text-[0.98rem] text-[var(--color-muted)]">
        {description}
      </p>
    )}

    <a class="mt-auto pt-[0.4rem] text-[0.9rem] font-semibold" href={href}>
      Read full story
    </a>
  </div>
</article>
