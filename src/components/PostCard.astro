---
import { getPostHref, getProvinces, getSummary, type Post } from "../lib/content"

interface Props {
  post: Post
}

const MONTHS = [
  "Jan",
  "Feb",
  "Mar",
  "Apr",
  "May",
  "Jun",
  "Jul",
  "Aug",
  "Sep",
  "Oct",
  "Nov",
  "Dec"
]

const { post } = Astro.props
const { title, date } = post.data
const summary = getSummary(post)

const href = getPostHref(post)
const image = post.data.image || undefined
const type = "Accomplishment"
const provinces = getProvinces(post.data)
const iso = date.toISOString().slice(0, 10)
const day = date.getUTCDate()
const month = `${MONTHS[date.getUTCMonth()]} ${date.getUTCFullYear()}`
---

<a href={href} class="group block">
  <div class="relative">
    {image ? (
      <img
        src={image}
        alt=""
        loading="lazy"
        class="aspect-[3/2] w-full rounded-md object-cover"
      />
    ) : (
      <div
        class="aspect-[3/2] w-full rounded-md bg-mist-deep bg-[url('/brand/dti-rapid.png')] bg-[length:auto_46%] bg-center bg-no-repeat"
        aria-hidden="true"
      />
    )}
    <time
      datetime={iso}
      class="absolute bottom-[-1.75rem] left-4 flex min-w-16 flex-col items-center rounded-[3px] border-t-[3px] border-dti-gold bg-navy px-[0.7rem] pt-[0.55rem] pb-2 leading-none text-mist shadow-[0_0_0_3px_var(--color-mist),0_10px_20px_-10px_rgb(6_22_51/0.6)]"
    >
      <span class="font-display text-[1.7rem] font-bold font-stretch-[100%] tracking-[-0.01em]">
        {day}
      </span>
      <span class="mt-[0.4rem] border-t border-mist/22 pt-[0.4rem] text-[0.62rem] font-semibold tracking-[0.14em] whitespace-nowrap text-mist/80 uppercase">
        {month}
      </span>
    </time>
  </div>
  <div class="mt-10">
    <p class="mb-2 text-[0.7rem] font-semibold tracking-[0.18em] text-ink/55 uppercase">
      {type}
      {provinces.length > 0 && (
        <span class="text-dti-blue"> · {provinces.join(", ")}</span>
      )}
    </p>
    <h3 class="line-clamp-3 text-xl leading-snug font-semibold tracking-tight text-navy decoration-navy decoration-1 underline-offset-4 group-hover:underline group-focus-visible:underline">
      {title}
    </h3>
    {summary && (
      <p class="mt-2 line-clamp-2 text-[0.975rem] leading-relaxed text-ink/65">
        {summary}
      </p>
    )}
  </div>
</a>
