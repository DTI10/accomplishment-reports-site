---
// Back-to-top button: appears after scrolling about one screen down; the dti-gold line shows reading progress.
---

<button
  type="button"
  class="fixed right-4 bottom-4 z-40 grid size-11 place-items-center overflow-hidden rounded-md bg-dti-blue text-mist shadow-[0_0_0_1px_rgb(234_238_246/0.2),0_12px_28px_-12px_rgb(6_22_51/0.6)] opacity-0 invisible translate-y-3 transition-[opacity,transform,visibility,background-color] duration-300 ease-[var(--ease-out-quint)] hover:bg-navy data-[shown]:visible data-[shown]:translate-y-0 data-[shown]:opacity-100 motion-reduce:transition-none sm:right-6 sm:bottom-6"
  aria-label="Back to top"
  title="Back to top"
  data-to-top
>
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <path
      d="M12 19V6M6 11l6-6 6 6"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
  </svg>
  <span
    class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-[var(--progress,0)] bg-dti-gold"
    aria-hidden="true"
    data-to-top-progress
  ></span>
</button>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-to-top]")
  const bar = document.querySelector<HTMLElement>("[data-to-top-progress]")
  let ticking = false

  const update = () => {
    ticking = false
    if (!btn) return
    const max = document.documentElement.scrollHeight - window.innerHeight
    const y = window.scrollY
    btn.toggleAttribute("data-shown", y > window.innerHeight)
    bar?.style.setProperty(
      "--progress",
      String(max > 0 ? Math.min(1, y / max) : 0)
    )
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        ticking = true
        requestAnimationFrame(update)
      }
    },
    { passive: true }
  )
  window.addEventListener("resize", update)
  update()

  btn?.addEventListener("click", () => {
    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches
    window.scrollTo({ top: 0, behavior: still ? "auto" : "smooth" })
    // keyboard and screen-reader users land at the start of the page
    document
      .querySelector<HTMLElement>('a[href="/#top"]')
      ?.focus({ preventScroll: true })
  })
</script>
