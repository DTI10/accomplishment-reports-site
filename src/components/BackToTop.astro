---
// Back-to-top button: appears after scrolling about one screen down; the dti-gold line shows reading progress.
---

<button type="button" class="to-top" aria-label="Back to top" title="Back to top" data-to-top>
	<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
		<path d="M12 19V6M6 11l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
	</svg>
	<span class="to-top-progress" aria-hidden="true" data-to-top-progress></span>
</button>

<style>
	.to-top {
		position: fixed;
		right: 1rem;
		bottom: 1rem;
		z-index: 40;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		overflow: hidden;
		border-radius: 6px;
		background: var(--color-dti-blue);
		color: var(--color-mist);
		box-shadow:
			0 0 0 1px rgb(234 238 246 / 0.2),
			0 12px 28px -12px rgb(6 22 51 / 0.6);
		opacity: 0;
		visibility: hidden;
		transform: translateY(0.75rem);
		transition:
			opacity 0.3s ease,
			transform 0.4s var(--ease-out-quint),
			visibility 0.3s,
			background-color 0.2s;
	}
	@media (min-width: 640px) {
		.to-top {
			right: 1.5rem;
			bottom: 1.5rem;
		}
	}
	.to-top[data-shown] {
		opacity: 1;
		visibility: visible;
		transform: none;
	}
	.to-top:hover {
		background: var(--color-navy);
	}
	/* reading progress along the bottom edge */
	.to-top-progress {
		position: absolute;
		left: 0;
		bottom: 0;
		height: 2px;
		width: 100%;
		background: var(--color-dti-gold);
		transform: scaleX(var(--progress, 0));
		transform-origin: left;
	}
	@media (prefers-reduced-motion: reduce) {
		.to-top {
			transition: none;
		}
	}
</style>

<script>
	const btn = document.querySelector<HTMLButtonElement>('[data-to-top]');
	const bar = document.querySelector<HTMLElement>('[data-to-top-progress]');
	let ticking = false;

	const update = () => {
		ticking = false;
		if (!btn) return;
		const max = document.documentElement.scrollHeight - window.innerHeight;
		const y = window.scrollY;
		btn.toggleAttribute('data-shown', y > window.innerHeight);
		bar?.style.setProperty('--progress', String(max > 0 ? Math.min(1, y / max) : 0));
	};

	window.addEventListener(
		'scroll',
		() => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		},
		{ passive: true },
	);
	window.addEventListener('resize', update);
	update();

	btn?.addEventListener('click', () => {
		const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		window.scrollTo({ top: 0, behavior: still ? 'auto' : 'smooth' });
		// keyboard and screen-reader users land at the start of the page
		document.querySelector<HTMLElement>('a[href="/#top"]')?.focus({ preventScroll: true });
	});
</script>
